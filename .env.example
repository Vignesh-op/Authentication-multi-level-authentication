# Authentication Environment Configuration
# Copy this file to .env and update values as needed

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# MongoDB Configuration (use MongoDB Atlas for production)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/authentication?retryWrites=true&w=majority

# Secret Key for Session (generate a strong random key for production)
SECRET_KEY=your-secure-secret-key-here-change-this-in-production

# Application Settings
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes

# Face Recognition Settings
FACE_RECOGNITION_TOLERANCE=0.25
FACE_RECOGNITION_MODEL=facial_geometry

# Admin Credentials (for first login)
ADMIN_EMAIL=Vignesh423@authentication.co.in
ADMIN_PASSWORD=your-secure-admin-password

# Server Settings (Render/deployment)
HOST=0.0.0.0
PORT=5000
