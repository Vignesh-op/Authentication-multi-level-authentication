# Authentication Environment Configuration
# Copy this file to .env and update values as needed

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# MongoDB Configuration
# Default: mongodb://localhost:27017/authentication
MONGO_URI=mongodb://localhost:27017/authentication

# Secret Key for Session
SECRET_KEY=authentication-secret-key-2026-change-in-production

# Application Settings
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes

# Face Recognition Settings
FACE_RECOGNITION_TOLERANCE=0.6
FACE_RECOGNITION_MODEL=hog  # Use 'hog' for speed, 'cnn' for accuracy

# Server Settings
HOST=127.0.0.1
PORT=5000
